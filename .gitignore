node_modules/
dist/
build/
*.tsbuildinfo

# Generated from schema.sql, the migrations, runtime.js and the curriculum packs so
# a standalone binary has them with no repository beside it. `npm install` rebuilds
# it via the prepare script; committing it would only let it drift from its sources.
src/generated/

# Never commit a child's record.
*.db
*.db-wal
*.db-shm
record.json
.primer/

# OpenClaw uses this repository as a pipeline agent's workspace (see
# docs/OPENCLAW.md) and bootstraps its own scaffolding here on first run. That
# is maintainer-side machinery: it must never reach a release, and `memory/`
# can accumulate agent session content. AGENTS.md is deliberately absent from
# this list, because docs/OPENCLAW.md expects a hand-written lane charter there.
SOUL.md
IDENTITY.md
HEARTBEAT.md
USER.md
TOOLS.md
memory/
openclaw-workspace-state.json
.DS_Store
